# ------------ App ------------
APP_ENV=production
APP_NAME=rabotaBot
APP_PUBLIC_BASE=/rabota
TZ=Europe/Warsaw
LOG_LEVEL=INFO

# ------------ Database ------------
POSTGRES_HOST=rabota-db
POSTGRES_PORT=5432
POSTGRES_DB=rabota
POSTGRES_USER=rabota
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5441

# ------------ Redis ------------
REDIS_HOST=rabota-redis
REDIS_PORT=6379
REDIS_HOST_PORT=6386

# ------------ Smart AI Gateway (local, free) ------------
# From other containers: attach to free_llm_api_gateway-net and use the internal URL.
LLM_GATEWAY_URL=http://gateway-nginx:80/v1
LLM_GATEWAY_API_KEY=
# Keep these on "auto". Pinning a named model inherits that one provider's
# cooldown: the gateway answers 503 "No available providers" instead of
# routing around it. Pin only to reproduce a specific behaviour.
LLM_MODEL_SCREEN=auto
LLM_MODEL_JUDGE=auto
LLM_MODEL_DRAFT=auto
LLM_TIMEOUT_S=90
LLM_MAX_CONCURRENCY=2
# Hard ceiling on LLM calls per 24h. Protects the shared free gateway from this app.
LLM_DAILY_CALL_CAP=400

# ------------ Telegram (dedicated rabotaBot bot) ------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only this chat id may command the bot. Empty = bot refuses every command.
TELEGRAM_DIGEST_HOUR=8

# Push new matches as they are found, not only in the morning digest.
PUSH_NEW_MATCHES=true
PUSH_MIN_PRIORITY=0
# Per run, so a large intake does not arrive as forty separate pings.
PUSH_MAX_PER_RUN=5
# Local hours when nothing is pushed. Anything found in the window waits.
PUSH_QUIET_FROM=23
PUSH_QUIET_TO=8
TELEGRAM_RETRO_WEEKDAY=6
TELEGRAM_RETRO_HOUR=18

# ------------ Pipeline policy ------------
# The research is unambiguous: throughput is not the lever. These caps are the product.
WEEKLY_SEND_CAP=18
DAILY_DIGEST_SIZE=12
JUDGE_TOP_K=40
DRAFT_MIN_PRIORITY=520

# ------------ Outbound hygiene ------------
HTTP_USER_AGENT=rabotaBot/1.0 (+https://yefrix.uk/rabota; personal job search)
HTTP_TIMEOUT_S=25
RESPECT_ROBOTS=true
